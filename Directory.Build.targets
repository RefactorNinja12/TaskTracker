<Project>
  <!-- Imported after the SDK's own default Compile glob include, so these Removes
       actually take effect (the same Removes in Directory.Build.props run too early
       and get overwritten by the SDK's later default include). -->
  <ItemGroup>
    <Compile Remove="obj-win/**" />
    <Compile Remove="obj-linux/**" />
    <Compile Remove="bin-win/**" />
    <Compile Remove="bin-linux/**" />
  </ItemGroup>
</Project>
