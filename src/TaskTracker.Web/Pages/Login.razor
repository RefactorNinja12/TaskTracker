@page "/"
@using TaskTracker.Web.Services
@inject AuthService AuthSvc
@inject NavigationManager Navigation

<div class = "background-div">
    <div class="left-background-container">

        <div>
            <h3 class="small-grey-text">TASKFLOW</h3>
        </div>
        <div>
            <h2 class="fat-text">Your work,</h2>
            <h2 class="bold-organized">organized.</h2>
            <h3 class="small-grey-text">Boards, tasks, and deadlines — all in one place. </h3>
            <h3 class="small-grey-text">No noise, no clutte</h3>
        </div>
        <div class = "bottom-container">
            <div class = "stat-container">
                <h2 class="stat-text">24k+</h2>
                <h4 class="small-grey-text">Teams</h4>
            </div>
            <div class = "stat-container">
                <h2 class="stat-text">1.2M</h2>
                <h4 class="small-grey-text">Task shipped</h4>
            </div>
            <div class = "stat-container">
                <h2 class="stat-text">99.9%</h2>
                <h4 class="small-grey-text">Uptime</h4>
            </div>

        </div>
    </div>
    <div class="right-background-container">
        <div class = "signin-title-container">
            <h2>Sign in</h2>
            <h3 class="small-grey-text">Welcome back — let's pick up where you left off.</h3>
        </div>
        <div class = "login-page">
            <form class = "login-form" @onsubmit="HandleLogin">
            <label>
                Email
            </label>
            <input class="form-element" type="email" @bind="email" />
            <label>
                Lösenord
            </label>
            <input class="form-element" type="password" @bind="password" />

            @if (!string.IsNullOrEmpty(errorMessage)){
                <p class="error-message">@errorMessage</p>
            }

            <button class="btn-element" type="submit">Log in</button>
            </form>


            <div>
            <div class="center-text">
                <p class="small-grey-text">Forgot your password? <a href="/register">Reset it</a></p>
            </div>
            <div class="center-text">
                <p class="small-grey-text">No account yet? <a href="/register">Create one</a></p>
            </div>
            

        </div>
        </div>
        
    </div>
</div>


@code {
    private string email = "";
    private string password = "";
    private string? errorMessage;

    private async Task HandleLogin(){
        var success = await AuthSvc.LoginAsync(email, password);

        if(success){
            Navigation.NavigateTo("/home");
        }
        else{
            errorMessage = "Fel email eller lösenord";
        }
    }


    }

