@using System.Net
@using TaskTracker.Contracts
@using TaskTracker.Web.Services
@inject BoardService BoardSvc
<div class="container">
    <div class="create-board-title">
        <h1>Create board</h1>
        

    </div>
    <form class="create-board-form" @onsubmit="HandleSubmit">
        

        <input class="form-input-field" type="text" placeholder="Title" @bind="title" />
        <input class="form-input-field" type="text" placeholder="Description" @bind="description" />
        <button class="btn-submit" type="submit">Create</button>
        <button class="btn-element" @onclick="HandleCancel">Cancel</button>
    </form>
</div>

@code{
    private string title = "";
    private string description = "";
    [Parameter]
    public EventCallback OnCancel {get; set;}
    [Parameter]
    public EventCallback<BoardResponse> OnBoardCreated {get; set;}

    private async Task HandleSubmit()
    {
        var response = await BoardSvc.CreateBoardAsync(title, description);
        await OnBoardCreated.InvokeAsync(response);
    }
    private async Task HandleCancel()
    {
        await OnCancel.InvokeAsync();
    }

    
}