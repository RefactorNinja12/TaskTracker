
@using TaskTracker.Contracts
@inject NavigationManager Navigation
<div class="container" @onclick="GoToTasks">
    <div>
            <h3>@Board.Title</h3>
            <h4>@Board.Description</h4>
        </div>
    <div class="task-stat-container">
        <div class="stat1">
            <p>@Board.ToDoCount Todo</p>
        </div>
        <div class="stat2" >
            <p>@Board.InProgressCount In Process</p>
        </div>
        <div class="stat3">
            <p>@Board.DoneCount Done</p>
        </div>
    </div>
    <div class="taskbar-container">
        <div class="full-bar-container">
            <div class="progress-bar" style="width:@(PercentDone)%">

            </div>
        </div>
    </div>
    <div class="bottom-text-container">
        <h4>@Board.CreatedAt.ToString("yyyy-MM-dd")</h4>
        <h4>@PercentDone% done</h4>
    </div>
</div>

@code{
    [Parameter]
    public BoardResponse Board {get; set;} = default!;

    private int TotalTasks => Board.ToDoCount + Board.InProgressCount + Board.DoneCount;
    private int PercentDone => TotalTasks == 0 ? 0 : (int)Math.Round(Board.DoneCount * 100.0 / TotalTasks);

    private void GoToTasks()
    {
        Navigation.NavigateTo($"/task/{Board.Id}");
    }
}